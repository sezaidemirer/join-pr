# SMTP - mail.joinpr.com.tr (SSL, port 465)
SMTP_HOST=mail.joinpr.com.tr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sezai@joinpr.com.tr
SMTP_PASSWORD=your_password_here

# Alıcı adresi (form mailleri bu adrese gider)
CONTACT_EMAIL=sezai@joinpr.com.tr

# WhatsApp Business (sabit buton için - uluslararası format: 905321234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=905321234567

# Medya yansıma raporu sayfası şifresi (isteğe bağlı; boş bırakırsanız sayfa şifresiz açılır)
NEXT_PUBLIC_MEDYA_RAPORU_PASSWORD=

# Supabase (medya raporu üye/giriş + monthly-intel API için)
# Dashboard: https://supabase.com/dashboard → Proje → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
