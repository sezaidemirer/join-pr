# joinescapes.com köküne ".htaccess" adıyla kopyalayın (Apache).
# React/Vite SPA: doğrudan /sanat-ve-cemiyet gibi URL'lerde sunucu dosya aramaz, index.html döner.
# /assets vb. gerçek dosyalar !-f ile olduğu gibi sunulur.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
