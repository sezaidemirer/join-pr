# Join PR Site - Next.js static export, public_html KÖK dizininde
# Bu dosya build sirasinda public/ -> out/ icine otomatik kopyalanir.

RewriteEngine On
DirectoryIndex index.html

# HTTPS zorunlu
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Mevcut dosya/klasor varsa dokunma (Next.js export klasor + index.html uretir)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 404 - Next.js export /404.html kullanir
ErrorDocument 404 /404.html

# _next/static hash'li dosyalar degismez; uzun sureli cache guvenli
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^.+\.(css|js|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
