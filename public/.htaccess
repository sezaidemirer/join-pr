# joinpr.com.tr statik site: build'de olmayan /haber/{slug} adresleri icin
# ayni URL korunarak /haber/detay/ kabugu sunulur (Apache mod_rewrite gerekir).
#
# HTML icin agresif no-cache (tarayici/CDN eski shell tutmasin). mod_headers yoksa blok atlanir.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header unset ETag
  </FilesMatch>
  <Files "build-stamp.json">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Medya yansima raporu dinamik slug fallback
  # /brand/project/entry — rapor detay sayfasi (entry slug veya uuid)
  # rapor-detay/ kalici shell sayfasi; MedyaYansimaRaporuEntryClient gercek URL'yi usePathname ile okur.
  RewriteRule ^medya-yansima-raporu/[^/]+/[^/]+/[^/]+/?$ /medya-yansima-raporu/rapor-detay/index.html [L]
  # /brand/project — alt marka rapor listesi
  RewriteRule ^medya-yansima-raporu/[^/]+/[^/]+/?$ /medya-yansima-raporu/rixos-egypt-hotel/rixos-radamis/index.html [L]
  # /brand — marka sayfasi
  RewriteRule ^medya-yansima-raporu/[^/]+/?$ /medya-yansima-raporu/rixos-egypt-hotel/index.html [L]

  # detay klasorunu tekrar yazdirma
  RewriteRule ^haber/(?!detay(?:$|/))([^/]+)/?$ /haber/detay/index.html [L]
</IfModule>
